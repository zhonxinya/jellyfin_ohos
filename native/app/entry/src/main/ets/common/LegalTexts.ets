export const PRIVACY_POLICY: string = `Jellyfin 鸿蒙客户端 · 隐私政策
版本：${LEGAL_VERSION}

一、关于本应用
1. 本应用是 Jellyfin 的**非官方第三方客户端**，与 Jellyfin 官方项目及其运营方无任何隶属、代理或合作关系。
